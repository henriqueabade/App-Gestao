# PROD (padrão): API remota. DEV: PostgreSQL configurado abaixo.
# Reinicie o aplicativo depois de alterar o modo.
BANCO=PROD
API_BASE_URL=https://api.santissimodecor.com.br

# Usadas exclusivamente pelo backend em DEV; não entram no instalador.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_NAME=
DB_PASSWORD=

# NF-e (SEFAZ-MG). O ambiente que VALE fica no banco (configuração fiscal,
# pelo Sup Admin). NFE_AMBIENTE=homologacao prende ESTA máquina em homologação
# mesmo com a produção ligada no banco; nunca liga a produção sozinho.
NFE_AMBIENTE=homologacao
# Só em DEV, fora do aplicativo: no app o certificado e a senha ficam no cofre
# do sistema (pasta fiscal/ do userData), nunca aqui.
# NFE_CERT_PATH=
# NFE_CERT_SENHA=
# Raízes ICP-Brasil em PEM, se o Node não confiar no servidor da SEFAZ.
# NFE_CA_PATH=
# Senha do SMTP do e-mail da NF-e, só em DEV: no app ela fica no cofre do sistema.
# NFE_SMTP_SENHA=
# Chave mestra dos segredos guardados no banco (certificado A1 + senha, senha do
# SMTP), para valerem em todas as máquinas. Gere uma vez e cole aqui:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ela o app usa só o cofre local de cada computador.
# SEGREDOS_CHAVE_MESTRA=

# Boletos (API Cobranças do Banco do Brasil). O ambiente que VALE fica no
# banco (configuração de cobrança, pelo Sup Admin). O ambiente de testes é a
# HOMOLOGAÇÃO do BB (oauth.hm / api.hm, com a conta de teste do banco);
# BB_AMBIENTE=sandbox (ou homologacao) prende ESTA máquina nos testes mesmo
# com a produção ligada; nunca liga a produção.
BB_AMBIENTE=sandbox
# Client secret do Portal Developers, só em DEV: no app ele fica no banco
# (cifrado) ou no cofre do sistema, guardado pela tela de configuração.
# BB_CLIENT_SECRET_SANDBOX=   (o da homologação)
# BB_CLIENT_SECRET_PRODUCAO=
# Se o BB trocar um endereço: BB_URL_OAUTH_SANDBOX, BB_URL_API_SANDBOX,
# BB_URL_OAUTH_PRODUCAO, BB_URL_API_PRODUCAO.
